# Copy to .env.local and fill in. Never commit .env.local.

# Public contact address rendered on the site. Leave empty to hide the email
# everywhere and show only the contact form / social links.
NEXT_PUBLIC_CONTACT_EMAIL=

# Formspree endpoint id (form id from your Formspree dashboard, e.g. xyzkabcd).
# Used by POST https://formspree.io/f/${NEXT_PUBLIC_FORMSPREE_ID}
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical origin for metadata, OG tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
